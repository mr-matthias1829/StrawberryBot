@startuml
title StrawberryBot - Use Case View
left to right direction
skinparam actorStyle awesome

actor Operator as OP
actor "ESP32 Controller" as ESP
actor Developer as DEV

rectangle "StrawberryBot System" {
  usecase "Detect strawberries\nautonomously" as UC1
  usecase "Stream live annotated\nvideo to browser" as UC2
  usecase "Tune detection\nparameters live" as UC3
  usecase "Switch to manual\ncontrol mode" as UC4
  usecase "Drive arm with\njoystick" as UC5
  usecase "Auto-grip confirmed\nstrawberry" as UC6
  usecase "Train detection\nmodel" as UC7
  usecase "Augment training\ndataset" as UC8
  usecase "Label training\nimages" as UC9
}

OP --> UC1
OP --> UC2
OP --> UC3
OP --> UC4
ESP --> UC5

UC4 ..> UC5 : include
UC1 ..> UC6 : include
UC1 ..> UC2 : include

DEV --> UC7
DEV --> UC8
DEV --> UC9
UC8 ..> UC7 : include
UC9 ..> UC8 : include

note right of UC3
  Via web dashboard.
  HSV ranges, thresholds,
  fusion weights - all live
  without restart.
end note

note right of UC4
  ESP32 sends UDP packets
  continuously. Disconnect
  detected automatically
  after 1 second timeout.
end note

@enduml
