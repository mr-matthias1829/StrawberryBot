@startuml
title StrawberryBot - Class Diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

class Main {
  +run_webcam()
  +run_image(image_path)
}

class Capture {
  -rtsp_url: str
  -label: str
  -frame: ndarray
  -lock: Lock
  -running: bool
  +read(): ndarray
  +release()
}

class Detection {
  +x1, y1, x2, y2: int
  +confidence: float
  +source: str
  +label: str
  +class_id: int
  +is_targetable: bool
  +color: tuple
  +class_name: str
}

class CVConfig {
  +h1_low, h1_high: int
  +h2_low, h2_high: int
  +sat_min, val_min, val_max: int
  +contour_min_circularity: float
  +max_aspect_ratio: float
  +watershed_fg_thresh: float
  +nms_iou_threshold: float
  +to_dict(): dict
  +from_dict(d): CVConfig
  +to_hsv_arrays(): tuple
}

class AIDetector {
  -model: YOLO
  +detect(frame, conf_threshold): List
}

class CVDectector {
  +detect(frame): tuple
  +cv_score_crop(frame, box): dict
  -_build_red_mask(frame, cfg)
  -_split_by_watershed(mask, contour, thresh)
  -_nms(boxes, scores, iou_threshold)
}

class DetectionWorker {
  -ai: AIDetector
  -cv: CVDectector
  -_frame_q: Queue
  -_zoom_q: Queue
  -_lock: Lock
  +push_frame(frame, small)
  +push_zoom(frame, box, source)
  +read_frame(): tuple
  +read_zoom(): list
  +stop()
}

class TrackedObject {
  +id: int
  +detection: Detection
  +seen_count: int
  +missed_count: int
  +fused_confidence: float
  +update(new_det)
  +miss()
  +is_confirmed: bool
  +is_active: bool
}

class FusionEngine {
  -_worker: DetectionWorker
  -robot: RobotController
  -tracked_objects: dict
  -next_id: int
  +process_frame(frame): tuple
  +shutdown()
  -_match_detections(ai_dets, cv_dets)
  -_fuse_decision(ai_det, cv_det, frame)
  -_update_tracking(fused_dets)
  -_classify_hits(tracked)
  +draw_annotations(...)
}

class RobotTarget {
  +detection: Detection
  +center_x, center_y: int
  +distance: float
  +depth_score: float
  +depth_units: float
}

class RobotController {
  -current_target: RobotTarget
  -_ghost_frames: int
  +choose_target(detections, gx, gy): RobotTarget
  +drive_hardware(gx, gy)
  +generate_dx(gx): int
  +generate_dy(gy): int
  +ready_to_grab(gx, gy): bool
  +estimate_depth(det): float
  +get_gripper_bbox(gx, gy): tuple
}

class motor <<module>> {
  +init()
  +shutdown()
  +_write_word(servo_id, address, value)
}

class turntable <<module>> {
  +init() / shutdown()
  +update(dx): str
  +spin_left(speed)
  +spin_right(speed)
  +stop()
}

class lift <<module>> {
  +init() / shutdown()
  +update(dy): str
  +move_up(speed)
  +move_down(speed)
  +stop()
}

class gripper <<module>> {
  +init() / shutdown()
  +grip(): dict
  +open_gripper(): dict
  +get_state(): str
  +command(action): dict
}

class CornerSensorManager {
  -bus: SMBus
  -channels: tuple
  -_laps: dict
  +read_sensor(ch): dict
  +read_all(): dict
  +reset_laps(ch)
}

class control_mode <<module>> {
  +start() / stop()
  +get_mode(): str
  +is_manual(): bool
  +is_autonomous(): bool
  +on_change(callback)
  -_set_mode(new_mode)
}

class Manual_controller <<module>> {
  +start() / stop()
  +is_active(): bool
  -_listener()
  -_apply_input(lx, ly, grip)
  -_stop_all()
}

class web_server <<module>> {
  +start(host, port)
  +push_frame(bgr)
  +push_log(line)
}

' Entry
Main ..> Capture
Main ..> FusionEngine
Main ..> control_mode
Main ..> web_server

' Fusion internals
FusionEngine *-- DetectionWorker
FusionEngine *-- RobotController
FusionEngine o-- TrackedObject
DetectionWorker *-- AIDetector
DetectionWorker *-- CVDectector

' Detection data
TrackedObject --> Detection
AIDetector ..> Detection
CVDectector ..> Detection
CVDectector ..> CVConfig

' Robot
RobotController --> RobotTarget
RobotTarget --> Detection
RobotController ..> turntable
RobotController ..> lift
RobotController ..> gripper

' Hardware
turntable --> motor
lift --> motor
gripper --> motor
turntable ..> CornerSensorManager
lift ..> CornerSensorManager
gripper ..> CornerSensorManager

' Control mode
control_mode --> Manual_controller
Manual_controller ..> turntable
Manual_controller ..> lift
Manual_controller ..> gripper

' Web
web_server ..> CVConfig
web_server ..> FusionEngine

@enduml
