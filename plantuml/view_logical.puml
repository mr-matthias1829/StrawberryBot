@startuml
title StrawberryBot - Logical View
skinparam componentStyle rectangle
left to right direction

package "Entry" {
  [Main.py] as MAIN
}

package "Camera" {
  [Capture\nRTSP reconnect thread] as CAP
}

package "Detection" {
  [FusionEngine\norchestrator] as FE
  [DetectionWorker\nbackground thread] as DW
  [AIDetector\nYOLOv8] as AI
  [CVDectector\nHSV + contour + watershed] as CV
  [CVConfig\nhot-swappable params] as CVCFG
}

package "Tracking" {
  [TrackedObject] as TRACK
  [RobotController\ntarget select + movement] as RC
}

package "Hardware" {
  [turntable.py\nservo ID 13] as TT
  [lift.py\nservos ID 3+4] as LIFT
  [gripper.py\nservo ID 8] as GRIP
  [motor.py\nserial + GPIO owner] as MOTOR
  [corner_sensors.py\nAS5600 via TCA9548A] as CSENS
}

package "Control Mode" {
  [control_mode.py\nauto vs manual state] as CM
  [Manual_controller.py\nUDP listener ESP32] as MC
}

package "Web" {
  [web_server.py\nFlask MJPEG SSE REST] as WS
}

package "Config" {
  [config.py\nall tuning constants] as CFG
}

package "Training (offline)" {
  [convert_csv.py] as CONV
  [convert_aug.py] as AUG
  [AiTrain.py] as TRAIN
}

MAIN --> CAP
MAIN --> FE
MAIN --> CM
MAIN --> WS

FE --> DW
FE --> CFG
DW --> AI
DW --> CV
CV --> CVCFG
AI --> CFG

FE --> TRACK
FE --> RC

RC --> TT
RC --> LIFT
RC --> GRIP
TT --> MOTOR
LIFT --> MOTOR
GRIP --> MOTOR
TT .> CSENS
LIFT .> CSENS
GRIP .> CSENS

WS --> CVCFG
WS --> FE
WS --> CFG

CM --> MC
MC --> CM
MC .> TT
MC .> LIFT

CONV --> AUG
AUG --> TRAIN

@enduml
